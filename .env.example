# Canonical site URL used for SEO (canonical, Open Graph, sitemap, robots).
VITE_SITE_URL=

# Contact e-mail used by the contact form (mailto fallback).
# Leave empty to show a clear placeholder instead of a broken form.
VITE_CONTACT_EMAIL=

# Social links. Leave empty to show "TODO: ADD REAL INFORMATION".
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Profile sidebar (right menu). Every field is optional — empty values are hidden.
# Leave VITE_PROFILE_IMAGE empty to render an elegant initials placeholder.
VITE_PROFILE_IMAGE=
VITE_PROFILE_LOCATION=
VITE_PROFILE_AVAILABILITY=
# Use the string "true" to show the availability indicator.
VITE_PROFILE_AVAILABLE=
